# Copy to .env and fill in. .env is git-ignored.

# Web research (required for web sources): Apify API token
APIFY_API_TOKEN=

# LLM step: claude-cli (default, local Claude Code CLI, no key) | grok-cli (local `agent` CLI, no key) | openai
DD_LLM=claude-cli
# optional: model for the Claude CLI, e.g. sonnet
DD_CLAUDE_MODEL=
# only for DD_LLM=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# pages fetched per search query
DD_RESULTS_PER_QUERY=3
